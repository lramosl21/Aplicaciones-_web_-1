* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #e8edf3;
    color: #333;
}


/* ENCABEZADO */

header {
    background-color: #1e3a5f;
    color: white;
    text-align: center;
    padding: 25px;
}

header h1 {
    margin: 0;
    font-size: 35px;
}

header p {
    margin: 8px 0 0;
}


/* MENU */

nav {
    background-color: #2f5d8a;
    text-align: center;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    margin: 0 15px;
}

nav a:hover {
    text-decoration: underline;
}


/* CONTENEDOR PRINCIPAL */

main {
    width: 100%;
    padding: 20px;
}

.ficha {
    background-color: white;
    width: 95%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.20);
}

.ficha h2 {
    text-align: center;
    color: #1e3a5f;
    font-size: 28px;
    margin: 0 0 10px 0;
}

.intro {
    text-align: center;
    font-size: 16px;
    margin: 0 0 20px 0;
}

.galeria {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
    flex-wrap: nowrap;
}

.tarjeta {
    background-color: #f5f7fa;
    width: 30%;
    padding: 15px;
    text-align: center;
    border-radius: 12px;
    border: 1px solid #ddd;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);

    display: flex;
    flex-direction: column;
}

.tarjeta img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
}

.tarjeta h3 {
    color: #1e3a5f;
    font-size: 20px;
    margin: 10px 0;
}

.tarjeta p {
    line-height: 1.4;
    margin: 5px 0;
    flex-grow: 1;
}

.boton {
    display: block;
    background-color: #2f5d8a;
    color: white;
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 6px;
    margin-top: 10px;
    text-align: center;
}
.boton:hover {
    background-color: #1e3a5f;
}


/* IMAGEN DE LAS FICHAS */

.foto-personaje {
    display: block;
    width: 250px;
    height: 300px;
    object-fit: cover;
    margin: 20px auto;
    border-radius: 10px;
}


/* BIOGRAFIA */

.biografia {
    margin-top: 25px;
}

.biografia h3 {
    color: #1e3a5f;
}

.biografia p {
    line-height: 1.7;
    text-align: justify;
}


/* TABLA */

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th {
    background-color: #1e3a5f;
    color: white;
    padding: 12px;
}

td {
    padding: 12px;
    text-align: center;
    border: 1px solid #ccc;
}


/* BOTONES INFERIORES */

.navegacion-ficha {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
}


/* PIE DE PAGINA */

footer {
    background-color: #1e3a5f;
    color: white;
    text-align: center;
    padding: 15px;
}


/* CELULAR */

@media (max-width: 700px) {

    nav a {
        display: block;
        margin: 10px;
    }

    .ficha {
        width: 95%;
        padding: 20px;
    }

    .tarjeta {
        width: 100%;
        max-width: 350px;
    }

    .navegacion-ficha {
        flex-direction: column;
        gap: 10px;
    }

}
